{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhn-aero-live-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "region": "gcp:asia-northeast3"
  },
  "routes": [
    {
      "pattern": "api.jukchang.com",
      "custom_domain": true
    },
    {
      "pattern": "jukchang.com/icanfixher",
      "zone_name": "jukchang.com"
    },
    {
      "pattern": "jukchang.com/icanfixher/*",
      "zone_name": "jukchang.com"
    }
  ],
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "AERO_LIVE_SESSION_LIMITER",
      "namespace_id": "720001",
      "simple": {
        "limit": 18,
        "period": 60
      }
    },
    {
      "name": "AERO_LIVE_IP_LIMITER",
      "namespace_id": "720002",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "AERO_LIVE_INVALID_LIMITER",
      "namespace_id": "720003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./.wrangler/game-assets",
    "binding": "GAME_ASSETS",
    "run_worker_first": true
  }
}
