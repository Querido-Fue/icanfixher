{
  "name": "nhn-aero-live-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "check": "npm run stage:game && wrangler deploy --dry-run",
    "dev": "npm run stage:game && wrangler dev",
